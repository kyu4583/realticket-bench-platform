# areas/06-vm-environment/.env.vm.example — VM·로컬 동기화 자격증명
#
# 사용법:
#   1) 본 파일 복사: cp areas/06-vm-environment/.env.vm.example areas/06-vm-environment/.env.vm
#   2) areas/06-vm-environment/.env.vm 의 값을 실제 비밀로 채움 (3 변수 모두 필수)
#   3) areas/06-vm-environment/.env.vm 은 .gitignore — commit 금지
#   4) 로컬 `areas/06-vm-environment/.env.vm` ↔ VM 측 동일 변수 export — *양쪽 값 일치 필수*
#      docker-stack.base.yml 의 `${VM_REALTICKET_*}` 가 stack deploy 시점 host shell 에서 expand 됨.
#      값 불일치 시 mysql/grafana 인증 실패 (사용자 책임 — m1 범위에선 *변수 컨벤션 lock* 까지만).
#   5) 동기화 메커니즘 (scp · ssh SendEnv · docker secrets 등) 자체는 m1 범위 밖.
#
# bench_stack.sh 진입부에서 3 변수 부재 시 fail-fast.

# MySQL root 계정 비밀번호 (mysql.MYSQL_ROOT_PASSWORD + nest-baseline.DATABASE_PASSWORD + healthcheck 동기)
VM_REALTICKET_MYSQL_ROOT_PASSWORD=

# MySQL 일반 계정 비밀번호 (mysql.MYSQL_PASSWORD — donggle 사용자)
VM_REALTICKET_MYSQL_PASSWORD=

# Grafana admin 계정 비밀번호 (grafana.GF_SECURITY_ADMIN_PASSWORD)
VM_REALTICKET_GRAFANA_ADMIN_PASSWORD=
